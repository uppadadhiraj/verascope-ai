# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Database (Postgres, run via docker-compose) ---
DATABASE_URL=postgresql+psycopg://verascope:verascope@localhost:5433/verascope

# --- Vector store (embedded ChromaDB, no server needed) ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Repository / workspace storage ---
REPO_STORAGE_DIR=./data/repos
WORKSPACE_STORAGE_DIR=./data/workspaces

# --- LLM provider (pluggable) ---
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_PROVIDER=local
# local = sentence-transformers (no API key needed); openai = text-embedding-3-small
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- GitHub integration ---
GITHUB_TOKEN=

# --- Docker sandbox ---
SANDBOX_IMAGE_PYTHON=python:3.12-slim
SANDBOX_IMAGE_NODE=node:20-slim
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK_DISABLED=true
SANDBOX_MAX_ITERATIONS=5

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
